# Remove a worktree with confirmation (supports wildcards, e.g. "pr-*")
# Usage: worktree remove [-y] [worktree_name|pattern]
#   -y  Skip all confirmation prompts (auto-yes)
function _wt_remove() {
  local force_yes=false

  # Parse flags
  while [[ "$1" == -* ]]; do
    case "$1" in
      -y) force_yes=true; shift ;;
      *)  echo "❌ Unknown option: $1"; return 1 ;;
    esac
  done

  local worktree_name="$1"

  # If no argument provided, show interactive selection menu
  if [[ -z "$worktree_name" ]]; then
    echo "🌳 Available worktrees:"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Get list of worktrees (excluding main)
    local -a worktrees
    worktrees=($(_wt_list_names --exclude-main))

    # Check if any removable worktrees exist
    if [[ ${#worktrees[@]} -eq 0 ]]; then
      echo "❌ No removable worktrees found (main worktree is protected)"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      return 1
    fi

    # Display selection menu
    echo "Select a worktree to remove (or press Ctrl+C to cancel):"
    echo ""
    PS3=$'\n🌳 Enter selection number: '

    select worktree_name in "${worktrees[@]}"; do
      if [[ -n "$worktree_name" ]]; then
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        break
      else
        echo "❌ Invalid selection. Please try again."
      fi
    done

    # If user cancelled (Ctrl+C), worktree_name will be empty
    if [[ -z "$worktree_name" ]]; then
      echo "❌ Cancelled"
      return 1
    fi
  fi

  # Check if the argument contains wildcard characters
  if [[ "$worktree_name" == *[\*\?\[]* ]]; then
    _wt_remove_glob "$force_yes" "$worktree_name"
    return $?
  fi

  # Protect main worktree from deletion
  if [[ "$worktree_name" == "main" ]]; then
    echo "❌ Error: Cannot remove 'main' worktree - it is protected"
    return 1
  fi

  local worktrees_dir=$(_get_worktree_root)

  # If CWD is inside the worktree being removed, navigate to main first.
  # git worktree remove deletes the directory, leaving the shell with a
  # non-existent CWD which breaks every subsequent git command.
  if [[ "$(pwd)" == "$worktrees_dir/$worktree_name"* ]]; then
    echo "📂 Navigating to main worktree before removal..."
    cd "$worktrees_dir/main" || {
      echo "❌ Error: Cannot navigate away from worktree being removed"
      return 1
    }
  fi

  # Get the branch name associated with this worktree before removing it.
  # Use grep -xF for exact fixed-string matching so slash-containing names
  # like "feature/login" don't cause false matches via regex interpretation.
  local branch_name=$(git worktree list --porcelain | \
    grep -xF "worktree $worktrees_dir/$worktree_name" -A 2 | \
    awk '/^branch/ { sub(/^refs\/heads\//, "", $2); print $2; exit }')

  if [[ "$force_yes" != true ]]; then
    echo "⚠️  Are you sure you want to remove worktree '$worktree_name'? (y/N)"
    read -r response
  else
    local response="y"
  fi

  if [[ "$response" =~ ^[Yy]$ ]]; then
    if git worktree remove "$worktrees_dir/$worktree_name"; then
      echo "✅ Worktree '$worktree_name' removed"

      # Check if the branch still exists and offer to delete it
      if [[ -n "$branch_name" ]] && git show-ref --verify --quiet "refs/heads/$branch_name"; then
        echo ""
        echo "🌿 Branch '$branch_name' still exists."
        if [[ "$force_yes" != true ]]; then
          echo "⚠️  Do you want to delete the branch '$branch_name'? (Y/n)"
          read -r branch_response
        else
          local branch_response="y"
        fi

        if [[ -z "$branch_response" || "$branch_response" =~ ^[Yy]$ ]]; then
          # Try normal deletion first
          if git branch -d "$branch_name" 2>/dev/null; then
            echo "✅ Branch '$branch_name' deleted"
          else
            # If normal deletion fails, offer force deletion
            echo "⚠️  Branch '$branch_name' has unmerged changes."
            if [[ "$force_yes" != true ]]; then
              echo "   Force delete? This will permanently lose any unmerged commits. (y/N)"
              read -r force_response
            else
              local force_response="y"
            fi

            if [[ "$force_response" =~ ^[Yy]$ ]]; then
              if git branch -D "$branch_name"; then
                echo "✅ Branch '$branch_name' force deleted"
              else
                echo "❌ Error: Failed to delete branch '$branch_name'"
                return 1
              fi
            else
              echo "ℹ️  Branch '$branch_name' kept (you can delete it later with: git branch -d $branch_name)"
            fi
          fi
        else
          echo "ℹ️  Branch '$branch_name' kept (you can delete it later with: git branch -d $branch_name)"
        fi
      fi
    else
      echo "❌ Error: Failed to remove worktree '$worktree_name'"
      return 1
    fi
  else
    echo "❌ Cancelled"
  fi
}
